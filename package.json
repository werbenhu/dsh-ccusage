{
  "name": "dsh-ccusage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 插件：ccusage 风格的 AI 编程用量分析，支持 Claude Code / Codex / OpenCode / Kimi / Grok / pi 和 DSH 自身会话，日/周/月/会话/5 小时块报表。",
  "homepage": "https://github.com/werbenhu/dsh-ccusage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/werbenhu/dsh-ccusage.git"
  },
  "bugs": {
    "url": "https://github.com/werbenhu/dsh-ccusage/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "data",
    "vendor",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ccusage",
    "usage",
    "cost",
    "tokens"
  ],
  "license": "MIT"
}
